{
  "$schema": "https://raw.githubusercontent.com/nicegui-dev/tauri-v2/main/core/tauri-config-schema/schema.json",
  "productName": "XRoads",
  "version": "0.1.0",
  "identifier": "io.neurogrid.xroads",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "title": "XRoads",
    "windows": [
      {
        "title": "XRoads Orchestrator",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
